# LLM (OpenAI-compatible)
LLM_BASE_URL=https://your-llm-provider/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0

# PostgreSQL
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/smartdata_agent

# Agent controls
AGENT_MAX_STEPS=12
AGENT_MAX_REPLANS=3
AGENT_STEP_TIMEOUT_SECONDS=60
